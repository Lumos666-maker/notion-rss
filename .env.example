NOTION_API_TOKEN=your_notion_api_token_here
NOTION_READER_DATABASE_ID=your_reader_database_id_here
NOTION_FEEDS_DATABASE_ID=your_feeds_database_id_here
RUN_FREQUENCY=86400
# 官方文档 https://www.feishu.cn/hc/zh-CN/category/7177281426289704962-%E9%A3%9E%E4%B9%A6%E6%9C%BA%E5%99%A8%E4%BA%BA%E5%8A%A9%E6%89%8B
FEISHU_WEBHOOK_URL=https://www.feishu.cn/flow/api/trigger-webhook/xxxx
CI=True

# 全文抓取 + 中文摘要。三个都填上才启用；缺任何一个则保持原来的行为（只收录，不写摘要）。
# LLM_BASE_URL 要带上版本路径，不要带 /chat/completions：
#   DeepSeek  https://api.deepseek.com/v1
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI    https://api.openai.com/v1
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 可选。FULLTEXT_FETCH=auto 时，只有配置了上面三个变量才会抓全文。
# LLM_CONCURRENCY=3
# LLM_INPUT_MAX_CHARS=4000
# ENRICH_WORKERS=4
# FULLTEXT_FETCH=auto
# FULLTEXT_TIMEOUT=12
# BACKFILL_DAYS=3
# 逗号分隔，追加到 blocklist.txt 上。默认不拦截。
# BLOCKLIST_KEYWORDS=
# BLOCKLIST_SOURCES=